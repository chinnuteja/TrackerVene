# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Required for live LLM calls. System uses deterministic fallback if unset.
AZURE_OPENAI_ENDPOINT=https://openaiservices-dev.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano

# ── Demo hygiene ───────────────────────────────────────────────────────────────
# Default OFF — demo runs don't write incidents back to resident.json.
# Set to 1 to persist incidents across restarts.
VENE_PERSIST_INCIDENTS=0

# ── LLM timeout ───────────────────────────────────────────────────────────────
VENE_LLM_TIMEOUT=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your deployed Vercel frontend URL in production.
VENE_ALLOWED_ORIGIN=https://your-app.vercel.app

# ── Frontend (set in Vercel project env vars) ─────────────────────────────────
# Points the Next.js frontend at your deployed backend WebSocket.
NEXT_PUBLIC_WS_URL=wss://your-backend-host/ws/feed
